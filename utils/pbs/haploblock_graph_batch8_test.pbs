#!/bin/bash
#PBS -N haploblock_graph_batch8
#PBS -l select=1:ncpus=192:mem=800gb
#PBS -l walltime=20:00:00
#PBS -o logs/haploblock_graph_batch8.out
#PBS -e logs/haploblock_graph_batch8.err
#PBS -j oe
cd /ngc/projects2/gm/people/mauqua/haploblocks
export NPROC=$PBS_NCPUS
export TMPDIR=/tmp
export APPTAINER_TMPDIR=/tmp
export OUTPUT_DIR=/output
export CHR_FILTER=chr13,chr16,chr17,chr18,chr19,chr20,chr21,chr22
export MIN_CLUSTER_SUPPORT=25
echo "Starting 8-chromosome batch job"
date
apptainer exec \
-B /ngc/projects2/gm/people/mauqua/haploblocks/tmp_batch8:/tmp \
-B /ngc/projects2/gm/people/mauqua/haploblocks/results:/data \
-B /ngc/projects2/gm/people/mauqua/haploblocks/graph_output_batch8:/output \
./haploblock_graph.sif \
python /app/haploblocks_to_graph.py
echo "Job finished"
date
