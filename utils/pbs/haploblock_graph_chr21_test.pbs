#!/bin/bash
#PBS -N haploblock_graph_chr21
#PBS -l select=1:ncpus=32:mem=200gb
#PBS -l walltime=8:00:00
#PBS -o logs/haploblock_graph_chr21.out
#PBS -e logs/haploblock_graph_chr21.err
#PBS -j oe
cd /ngc/projects2/gm/people/mauqua/haploblocks
export NPROC=$PBS_NCPUS
export TMPDIR=/tmp
export APPTAINER_TMPDIR=/tmp
export OUTPUT_DIR=/output
export CHR_FILTER=chr21
export MIN_CLUSTER_SUPPORT=25
echo "Starting chr21 scoped test job"
date
apptainer exec \
-B /ngc/projects2/gm/people/mauqua/haploblocks/tmp_chr21:/tmp \
-B /ngc/projects2/gm/people/mauqua/haploblocks/results:/data \
-B /ngc/projects2/gm/people/mauqua/haploblocks/graph_output_chr21:/output \
./haploblock_graph.sif \
python /app/haploblocks_to_graph.py
echo "Job finished"
date
